# AI Bug Hunter - Environment Variables Configuration

# MongoDB Atlas Database Configuration
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_bug_hunter
MONGODB_DB_NAME=ai_bug_hunter

# Security & Authentication
JWT_SECRET=super-secret-jwt-token-key-2026-change-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# OpenRouter.ai Intelligence Engine
AI_PROVIDER=openrouter
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
DEFAULT_LLM_MODEL=deepseek/deepseek-chat

# Cloud AI Provider Keys (Optional)
OPENAI_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
CLAUDE_API_KEY=
GROK_API_KEY=
