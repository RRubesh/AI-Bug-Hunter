# ==============================================================================
# AI BUG HUNTER - ENTERPRISE SAST & SECURE CODE ANALYSIS CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite)
# ------------------------------------------------------------------------------
# In production, set this to your deployed FastAPI backend URL.
# If hosting frontend and backend on the same origin (e.g. Vercel serverless /api), leave blank.
VITE_API_URL=
VITE_API_BASE_URL=

# ------------------------------------------------------------------------------
# 2. BACKEND DATABASE CONFIGURATION (MongoDB Atlas / Dual Storage)
# ------------------------------------------------------------------------------
# MongoDB Atlas Connection URI (Enterprise Multi-Tenant Store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.XXXXX.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=ai_bug_hunter

# Primary Relational Database URL (SQLite WAL default or PostgreSQL)
DATABASE_URL=sqlite:///./ai_bug_hunter.db

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & DEFENSIVE SECURITY
# ------------------------------------------------------------------------------
SECRET_KEY=generate-a-strong-random-64-char-secret-key-for-production
JWT_SECRET=generate-a-strong-random-64-char-secret-key-for-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["*"]
FRONTEND_URL=https://ai-bug-hunter-tawny.vercel.app

# ------------------------------------------------------------------------------
# 4. EMAIL DELIVERY & PASSWORD RECOVERY (SMTP / Cloud Providers)
# ------------------------------------------------------------------------------
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-specific-password-or-smtp-key
SMTP_FROM_EMAIL=security@aibughunter.com
SMTP_FROM_NAME=AI Bug Hunter Security
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Optional Cloud Email APIs
RESEND_API_KEY=
SENDGRID_API_KEY=

# ------------------------------------------------------------------------------
# 5. AI SECURITY REMEDIATION ENGINE (OpenRouter / Multi-Provider)
# ------------------------------------------------------------------------------
AI_PROVIDER=openrouter
OPENROUTER_API_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=your-openrouter-api-key-here
DEFAULT_LLM_MODEL=deepseek/deepseek-chat

# Optional Direct Cloud Provider API Keys
OPENAI_API_KEY=your-openai-api-key-here
GEMINI_API_KEY=your-gemini-api-key-here
GROQ_API_KEY=your-groq-api-key-here
CLAUDE_API_KEY=your-anthropic-api-key-here
GROK_API_KEY=your-xai-grok-api-key-here
